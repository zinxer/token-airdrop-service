# Network Configuration
# Options: sepolia, mainnet
NETWORK=sepolia

# Alchemy API Configuration
ALCHEMY_API_KEY=<your-alchemy-api-key>

# Ethereum Wallet Configuration (Distribution Account)
DISTRIBUTION_WALLET_PRIVATE_KEY=<your-distribution-wallet-private-key>

# Database Configuration
DATABASE_URL="mysql://<user>:<password>@localhost:3306/token_airdrop"

# Server Configuration
PORT=3000
NODE_ENV=development

# Queue system now uses MySQL database directly

# Token Configuration
TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
TOKEN_DECIMALS=18

# Logging configuration
LOG_LEVEL=info

# Set to true to run in dry run mode (no transactions will be sent)
DRYRUN=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Prisma Database Logging (optional)
# Set to 'true' to enable detailed SQL query logging
PRISMA_LOG_QUERIES=false
# Set to 'false' to disable info logs in development
PRISMA_LOG_INFO=true 